rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /siteSettings/mainPage {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteSettings/aboutPage {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteSettings/commonPage {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteSettings/qePage {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteSettings/projectsPage {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteSettings/conversationsPage {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
